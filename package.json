{
  "name": "my-portafolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/generate-art.mjs",
    "audit:desktop": "lighthouse http://localhost:3000 --preset=desktop --output=html --output=json --output-path=docs/evidencias/lighthouse-desktop --chrome-flags=\"--headless=new\"",
    "audit:mobile": "lighthouse http://localhost:3000 --output=html --output=json --output-path=docs/evidencias/lighthouse-mobile --chrome-flags=\"--headless=new\"",
    "check:seo": "node scripts/check-seo.mjs",
    "check:origin": "node --test scripts/site-origin.test.mjs",
    "audit:all": "node scripts/audit-all.mjs",
    "format": "prettier --write src scripts next.config.ts"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "lighthouse": "^13.6.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
